# Raspberry PiのLANに合わせて変更してください。空欄なら自動検出します。
NETWORK_SUBNET=192.168.10.0/24
NETWORK_INTERFACE=
GATEWAY_HOST=192.168.10.1

# `id -u` / `id -g` の値。dataディレクトリへの書き込みに使います。
PUID=1000
PGID=1000

# カンマ区切りで、常に死活を見たい機器を追加できます。
# 例: NAS、DNS、アクセスポイント
MONITORED_HOSTS=192.168.10.1

SAMPLE_INTERVAL_SECONDS=2
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_SECONDS=120
DEVICE_OFFLINE_AFTER_SECONDS=90
RETENTION_DAYS=30
DEMO_MODE=false

# DNSとインターネット到達性。DNS_SERVERSが空ならゲートウェイを使います。
CONNECTIVITY_ENABLED=true
CONNECTIVITY_INTERVAL_SECONDS=15
INTERNET_TARGETS=1.1.1.1,8.8.8.8
DNS_SERVERS=192.168.10.1
DNS_CHECK_NAME=example.com

# ルーター側でSNMPv2cの読み取りを有効化してから設定します。
# WANインターフェース番号はルーターのifIndexに合わせてください。
SNMP_ENABLED=false
SNMP_TARGETS=192.168.10.1
SNMP_COMMUNITY=public
SNMP_INTERVAL_SECONDS=30
SNMP_INTERFACE_INDEX=2
# ベンダー固有OIDは name=oid の形式でカンマ区切りにできます。
# 例: wifi_clients=1.3.6.1.4.1.x.x,wifi_signal=1.3.6.1.4.1.x.y
SNMP_EXTRA_OIDS=

# 32バイト以上のランダム値を設定し、Gitやチャットへ貼らないでください。
AGENT_TOKEN=
AGENT_OFFLINE_AFTER_SECONDS=60

ANOMALY_ENABLED=true
ANOMALY_INTERVAL_SECONDS=30
ANOMALY_MIN_SAMPLES=20

# OpenAI互換のローカルLLM（LM Studio / Ollamaなど）。画面からも変更できます。
# 別PC上のLM Studioを使う場合は、そのPCのLAN IPと /v1 を指定してください。
LLM_REPORT_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
# 画面から編集可能。空の場合は日本語のネットワーク運用報告用プロンプトを使用します。
LLM_SYSTEM_PROMPT=
# 通常のLM Studioでは空欄で構いません。値はGitやチャットへ貼らないでください。
LLM_API_KEY=
LLM_REPORT_INTERVAL_MINUTES=60
LLM_REPORT_LOOKBACK_MINUTES=60
LLM_REQUEST_TIMEOUT_SECONDS=120
TZ=Asia/Tokyo
