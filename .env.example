# Raspberry PiのLANに合わせて変更してください。空欄なら自動検出します。
NETWORK_SUBNET=192.168.10.0/24
NETWORK_INTERFACE=
GATEWAY_HOST=192.168.10.1

# `id -u` / `id -g` の値。dataディレクトリへの書き込みに使います。
PUID=1000
PGID=1000

# カンマ区切りで、常に死活を見たい機器を追加できます。
# 例: NAS、DNS、アクセスポイント
MONITORED_HOSTS=192.168.10.1

SAMPLE_INTERVAL_SECONDS=2
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_SECONDS=120
DEVICE_OFFLINE_AFTER_SECONDS=90
RETENTION_DAYS=30
DEMO_MODE=false

# LAN内サービスの到達性。name=icmp://IP、name=tcp://host:port、HTTP(S) URLに対応します。
CONNECTIVITY_ENABLED=true
CONNECTIVITY_INTERVAL_SECONDS=15
LAN_PROBE_TARGETS=gateway=icmp://192.168.10.1

# 外部ICMP/DNSチェックが必要な場合だけ有効にします。既定ではインターネット側へプローブしません。
INTERNET_PROBES_ENABLED=false
INTERNET_TARGETS=1.1.1.1,8.8.8.8
DNS_SERVERS=192.168.10.1
DNS_CHECK_NAME=example.com

# QNAPはSNMPv3 authPrivを使います。パスワードはGitやチャットへ貼らないでください。
# ルーターの従来収集では VERSION=2c、PROFILE=generic、COMMUNITYを使用できます。
SNMP_ENABLED=false
SNMP_TARGETS=
SNMP_VERSION=3
SNMP_PROFILE=qnap
SNMP_USERNAME=
# QTS側がHMAC-MD5の場合はMD5。SHAを選べる場合は両側をSHAにします。
SNMP_AUTH_PROTOCOL=MD5
SNMP_AUTH_PASSWORD=
# TS-464のQTS画面に合わせてCBC-DESをDESと指定します。
SNMP_PRIV_PROTOCOL=DES
SNMP_PRIV_PASSWORD=
SNMP_COMMUNITY=public
SNMP_INTERVAL_SECONDS=30
SNMP_TIMEOUT_SECONDS=2
# genericプロファイルでルーターWANカウンターを取る場合だけ使います。
SNMP_INTERFACE_INDEX=2
# ベンダー固有OIDは name=oid の形式でカンマ区切りにできます。
# 例: wifi_clients=1.3.6.1.4.1.x.x,wifi_signal=1.3.6.1.4.1.x.y
SNMP_EXTRA_OIDS=

# SNMP/OpenWrtを使わず、管理対象ホストのPrometheus exporterを直接読み取ります。
# URLはLAN内アドレスだけを許可します。認証情報・クエリ文字列はURLへ含められません。
# 例: linux-nas=http://192.168.10.20:9100/metrics,windows-pc=http://192.168.10.30:9182/metrics
PROMETHEUS_EXPORTERS_ENABLED=false
PROMETHEUS_EXPORTER_TARGETS=
PROMETHEUS_EXPORTER_INTERVAL_SECONDS=15
PROMETHEUS_EXPORTER_TIMEOUT_SECONDS=5

# 32バイト以上のランダム値を設定し、Gitやチャットへ貼らないでください。
AGENT_TOKEN=
AGENT_OFFLINE_AFTER_SECONDS=60

# UIとAPIはLAN全体から到達可能なので、既定ではBasic認証が必須です。
# WEB_AUTH_USERとWEB_AUTH_PASSWORDの両方を設定してください。
# パスワードは `openssl rand -base64 24` のようなランダム値を使い、Gitやチャットへ貼らないでください。
WEB_AUTH_USER=
WEB_AUTH_PASSWORD=
# 意図的に認証なしで起動する場合（ローカル開発など）だけfalseにします。
WEB_AUTH_REQUIRED=true

ANOMALY_ENABLED=true
ANOMALY_INTERVAL_SECONDS=30
ANOMALY_MIN_SAMPLES=20

# OpenAI互換のローカルLLM（LM Studio / Ollamaなど）。画面からも変更できます。
# 別PC上のLM Studioを使う場合は、そのPCのLAN IPと /v1 を指定してください。
LLM_REPORT_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 既定ではLLM Base URLはLAN内アドレス（ループバック/プライベート）のみ許可します。公開APIを使う場合だけtrueにします。
LLM_ALLOW_EXTERNAL=false
LLM_MODEL=
# 画面から編集可能。空の場合は日本語のネットワーク運用報告用プロンプトを使用します。
LLM_SYSTEM_PROMPT=
# 通常のLM Studioでは空欄で構いません。値はGitやチャットへ貼らないでください。
LLM_API_KEY=
LLM_REPORT_INTERVAL_MINUTES=60
LLM_REPORT_LOOKBACK_MINUTES=60
LLM_REQUEST_TIMEOUT_SECONDS=120

# アラート時のプッシュ通知（ntfy / Webhook）。画面の ALERTS でも設定できます。
# ntfyはサーバーURL+トピック、またはWebhook URLのいずれかを設定すると有効になります。
NOTIFY_ENABLED=false
NOTIFY_SERVER_URL=
NOTIFY_TOPIC=
NOTIFY_PRIORITY=3
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
NOTIFY_COOLDOWN_MINUTES=15
NOTIFY_TIMEOUT_SECONDS=8
# 既定では通知先はLAN内アドレスのみ許可します。ntfy.shなどの外部サービスを使う場合だけtrueにします。
NOTIFY_ALLOW_EXTERNAL=false

TZ=Asia/Tokyo
